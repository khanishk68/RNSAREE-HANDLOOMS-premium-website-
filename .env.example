# PostgreSQL (Neon or Prisma Postgres) — required for live catalogue, admin, and COD orders
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/neondb?sslmode=require"

# Claim temporary Prisma create-db databases before they expire (24h):
# PRISMA_CLAIM_URL="https://create-db.prisma.io/claim?projectID=..."

# Server-only admin login (never expose the password to the browser)
JWT_SECRET="change-me-to-a-long-random-secret"
ADMIN_EMAIL="admin@rnsareehandlooms.com"
ADMIN_PASSWORD="change-me-strong-password"

NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Cloudinary (required on Vercel — public/uploads is read-only there)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Or a single URL instead of the three vars above:
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# Vercel → Settings → Environment Variables (Production + Preview):
#   DATABASE_URL
#   JWT_SECRET
#   ADMIN_EMAIL
#   ADMIN_PASSWORD
#   NEXT_PUBLIC_SITE_URL
#   CLOUDINARY_CLOUD_NAME
#   CLOUDINARY_API_KEY
#   CLOUDINARY_API_SECRET
#
# After first deploy, seed once against the same DATABASE_URL:
#   npm run db:seed
