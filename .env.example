# PostgreSQL connection (Neon, Prisma Postgres, or any Postgres)
# Local example after create-db / Neon:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Claim temporary Prisma create-db databases before they expire (24h):
# PRISMA_CLAIM_URL="https://create-db.prisma.io/claim?projectID=..."

JWT_SECRET="change-me-to-a-long-random-secret"
ADMIN_EMAIL="admin@rnsareehandlooms.com"
ADMIN_PASSWORD="change-me-strong-password"
NEXT_PUBLIC_ADMIN_EMAIL="admin@rnsareehandlooms.com"
NEXT_PUBLIC_ADMIN_PASSWORD="change-me-strong-password"
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# COD orders:
# - With a working DATABASE_URL → saved in Postgres
# - If DB is unreachable locally → saved to data/orders.json (admin + track-order still work)
# - On Vercel you need a live DATABASE_URL (filesystem is read-only)

# Vercel setup:
# 1. Project → Settings → Environment Variables
# 2. Add DATABASE_URL (same Postgres URL), ADMIN_EMAIL, ADMIN_PASSWORD, JWT_SECRET, NEXT_PUBLIC_SITE_URL
# 3. Redeploy
# 4. Run seed once locally against that DB: npm run db:seed
